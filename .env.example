# Server-only Firebase configuration.
# Set these in Vercel Project Settings > Environment Variables.
# For local serverless development, copy to .env.local
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_admin_service_account_email
FIREBASE_PRIVATE_KEY=replace_with_service_account_private_key
FIREBASE_WEB_API_KEY=your_firebase_web_api_key
CRON_SECRET=generate_a_long_random_secret_for_vercel_cron
